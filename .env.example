# ===== Vercel Production ======================================================
# Set this in Vercel -> Project -> Settings -> Environment Variables.
# This is a PUBLIC endpoint and will be included in browser JavaScript.
API_BASE_URL=https://api.manhwavoid.space/api/v1

# ===== Local development ======================================================
# Leave API_BASE_URL unset locally to use the Vite /api proxy.
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# ===== Branding (optional) ====================================================
VITE_SITE_NAME=Manhwa Void

# Never place credentials, MongoDB URIs, JWT secrets, or proxy secrets in
# API_BASE_URL or any VITE_* variable.
